#: admin.py:13
msgid "Enable selected columns"
msgstr "Włącz wybrane kolumny"

#: admin.py:18
msgid "Disable selected columns"
msgstr "Wyłącz wybrane kolumny"

#: admin.py:50
msgid "Model admin name"
msgstr "Nazwa modułu administracyjnego"

#: admin.py:102 models.py:260
msgid "Column name"
msgstr "Nazwa kolumny"

#: apps.py:8
msgid "Admin dynamic columns"
msgstr "Dynamiczne kolumny administracji"

#: mixins.py:186
msgid ""
"Editing the global defaults. Every user without a personal layout will see "
"these columns."
msgstr ""
"Edytujesz globalne ustawienia domyślne. Każdy użytkownik bez osobistego "
"układu zobaczy te kolumny."

#: mixins.py:190
msgid ""
"★ You are viewing your personal layout. Saves apply only to your account."
msgstr ""
"★ Widzisz swój osobisty układ. Zapisy dotyczą wyłącznie Twojego konta."

#: mixins.py:194 templates/dynamic_admin_columns/change_list.html:71
#: templates/dynamic_admin_columns/grappelli/change_list.html:98
msgid ""
"You are viewing the global defaults. Saving will create a personal layout "
"for your account."
msgstr ""
"Widzisz globalne ustawienia domyślne. Zapisanie zmian utworzy osobisty układ "
"przypisany do Twojego konta."

#: mixins.py:197 templates/dynamic_admin_columns/change_list.html:87
#: templates/dynamic_admin_columns/grappelli/change_list.html:123
msgid "Discard personal layout"
msgstr "Usuń osobisty układ"

#: mixins.py:198
msgid "Reset global defaults from code"
msgstr "Przywróć globalne ustawienia z kodu"

#: mixins.py:200
msgid ""
"Reset the GLOBAL defaults? They will be re-derived from code on the next "
"changelist load."
msgstr ""
"Zresetować GLOBALNE ustawienia? Zostaną one ponownie wyznaczone z kodu "
"przy następnym wyświetleniu listy."

#: mixins.py:204
msgid "Discard your personal column layout and use the defaults?"
msgstr "Usunąć Twój osobisty układ kolumn i wrócić do ustawień domyślnych?"

#: mixins.py:206
msgid "Failed to save columns: "
msgstr "Nie udało się zapisać kolumn: "

#: mixins.py:207
msgid "Failed to reset."
msgstr "Nie udało się zresetować."

#: models.py:178
msgid "User"
msgstr "Użytkownik"

#: models.py:180
msgid ""
"If set, this is a personal column configuration owned by that user. NULL "
"rows are global defaults."
msgstr ""
"Jeżeli ustawione, jest to osobista konfiguracja kolumn należąca do tego "
"użytkownika. Wiersze z wartością NULL stanowią ustawienia globalne."

#: models.py:213
msgid "Model admin"
msgstr "Moduł administracyjny"

#: models.py:214
msgid "Model admins"
msgstr "Moduły administracyjne"

#: models.py:257
msgid "Parent"
msgstr "Moduł nadrzędny"

#: models.py:262
msgid "Enabled"
msgstr "Widoczna"

#: models.py:263
msgid "Ordering"
msgstr "Kolejność"

#: models.py:269
msgid "Model admin column"
msgstr "Kolumna modułu administracyjnego"

#: models.py:270
msgid "Model admin columns"
msgstr "Kolumny modułu administracyjnego"

#: models.py:273
msgid "Column"
msgstr "Kolumna"

#: models.py:276
msgid " of model "
msgstr " modelu "

#: templates/dynamic_admin_columns/change_list.html:25
#: templates/dynamic_admin_columns/grappelli/change_list.html:48
msgid "Columns"
msgstr "Kolumny"

#: templates/dynamic_admin_columns/change_list.html:44
#: templates/dynamic_admin_columns/grappelli/change_list.html:71
msgid "Configure columns"
msgstr "Konfiguruj kolumny"

#: templates/dynamic_admin_columns/change_list.html:48
#: templates/dynamic_admin_columns/grappelli/change_list.html:75
msgid "Scope"
msgstr "Zasięg"

#: templates/dynamic_admin_columns/change_list.html:52
#: templates/dynamic_admin_columns/grappelli/change_list.html:79
msgid "My personal layout"
msgstr "Mój osobisty układ"

#: templates/dynamic_admin_columns/change_list.html:53
#: templates/dynamic_admin_columns/grappelli/change_list.html:80
msgid "Affects only your account."
msgstr "Dotyczy wyłącznie Twojego konta."

#: templates/dynamic_admin_columns/change_list.html:59
#: templates/dynamic_admin_columns/grappelli/change_list.html:86
msgid "Global defaults"
msgstr "Domyślne globalne"

#: templates/dynamic_admin_columns/change_list.html:60
#: templates/dynamic_admin_columns/grappelli/change_list.html:87
msgid "Visible to every user that has no personal layout. Superusers only."
msgstr ""
"Widoczne dla każdego użytkownika, który nie ma osobistego układu. Tylko dla "
"administratorów."

#: templates/dynamic_admin_columns/change_list.html:69
#: templates/dynamic_admin_columns/grappelli/change_list.html:96
msgid "You are viewing your personal layout. Saves apply only to your account."
msgstr ""
"Wyświetlasz swój osobisty układ. Zapisy dotyczą wyłącznie Twojego konta."

#: templates/dynamic_admin_columns/change_list.html:76
#: templates/dynamic_admin_columns/grappelli/change_list.html:103
msgid "Drag rows to reorder; toggle the checkbox to show or hide a column."
msgstr ""
"Przeciągnij wiersze, aby zmienić kolejność; zaznacz pole, aby pokazać lub "
"ukryć kolumnę."

#: templates/dynamic_admin_columns/change_list.html:81
#: templates/dynamic_admin_columns/grappelli/change_list.html:108
msgid "No user-configurable columns are declared for this admin."
msgstr ""
"Dla tego modułu administracyjnego nie zadeklarowano kolumn możliwych do "
"konfiguracji przez użytkownika."

#: templates/dynamic_admin_columns/change_list.html:91
#: templates/dynamic_admin_columns/grappelli/change_list.html:129
msgid "Cancel"
msgstr "Anuluj"

#: templates/dynamic_admin_columns/change_list.html:94
#: templates/dynamic_admin_columns/grappelli/change_list.html:134
msgid "Save"
msgstr "Zapisz"
